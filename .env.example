# Optional public frontend settings. Never put tokens in VITE_* variables.
VITE_GITHUB_API_URL=https://api.github.com
# Set /RepoLens/ for a GitHub project Pages site; / for Vercel.
VITE_BASE_PATH=/
# Enable only on Vercel with the server environment below configured.
VITE_ENABLE_AUTH=false

# SERVER ONLY: Vercel environment settings, never exposed through VITE_*.
# GitHub OAuth App callback: https://your-domain/api/auth?action=callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate a random value with: openssl rand -hex 32
SESSION_SECRET=
APP_URL=http://localhost:3000
